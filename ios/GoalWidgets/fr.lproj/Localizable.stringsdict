<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Pluriels français (0 et 1 = « one »). Mêmes clés que les <plurals> Android. -->
<plist version="1.0">
<dict>
	<key>countdown_in_days</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@days@</string>
		<key>days</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>dans %ld jour</string>
			<key>other</key>
			<string>dans %ld jours</string>
		</dict>
	</dict>
	<key>countdown_reached_days_ago</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@days@</string>
		<key>days</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>Atteint il y a %ld jour</string>
			<key>other</key>
			<string>Atteint il y a %ld jours</string>
		</dict>
	</dict>
	<key>since_days</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>Depuis %ld jour</string>
			<key>many</key>
			<string>Depuis %ld jours</string>
			<key>other</key>
			<string>Depuis %ld jours</string>
		</dict>
	</dict>
	<key>breakdown_years</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%ld an</string>
			<key>many</key>
			<string>%ld ans</string>
			<key>other</key>
			<string>%ld ans</string>
		</dict>
	</dict>
	<key>breakdown_months</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%ld mois</string>
			<key>many</key>
			<string>%ld mois</string>
			<key>other</key>
			<string>%ld mois</string>
		</dict>
	</dict>
	<key>breakdown_days</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%ld jour</string>
			<key>many</key>
			<string>%ld jours</string>
			<key>other</key>
			<string>%ld jours</string>
		</dict>
	</dict>
	<key>notif_countdown_days_left</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>Plus que %ld jour</string>
			<key>many</key>
			<string>Plus que %ld jours</string>
			<key>other</key>
			<string>Plus que %ld jours</string>
		</dict>
	</dict>
	<key>export_done</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%ld objectif exporté</string>
			<key>many</key>
			<string>%ld objectifs exportés</string>
			<key>other</key>
			<string>%ld objectifs exportés</string>
		</dict>
	</dict>
	<key>import_added</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%ld objectif importé</string>
			<key>many</key>
			<string>%ld objectifs importés</string>
			<key>other</key>
			<string>%ld objectifs importés</string>
		</dict>
	</dict>
	<key>import_skipped</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%ld déjà présent</string>
			<key>many</key>
			<string>%ld déjà présents</string>
			<key>other</key>
			<string>%ld déjà présents</string>
		</dict>
	</dict>
</dict>
</plist>
